#!/usr/bin/env bash
#MISE description="Human only. Prompt for hosted function secrets (hidden input) and set them. No copy is kept"
. "$MISE_PROJECT_ROOT/scripts/lib.sh"
[ -t 0 ] || die "secrets:hosted needs a human at a terminal."
confirm_hosted "set GEMINI_API_KEY, ROBOFLOW_API_KEY and NANO_BANANA_API_KEY" "set IMAGE_PROVIDER=nano-banana"

args=()
for name in GEMINI_API_KEY ROBOFLOW_API_KEY NANO_BANANA_API_KEY; do
  read -r -s -p "$name (hidden): " value
  printf '\n'
  [ -n "$value" ] || die "$name is empty. Nothing was set."
  args+=("$name=$value")
done
args+=("IMAGE_PROVIDER=nano-banana")

pnpm supabase secrets set --remote="${HOSTED_PROJECT_REF:?}" --yes "${args[@]}"
unset args value
printf '✓ Set. No copy was kept. If a key is lost, mint a new one and run this again.\n'
