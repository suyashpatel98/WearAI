#!/usr/bin/env bash
#MISE description="Start Metro for the development build against local (APP_ENV=hosted for hosted)"
. "$MISE_PROJECT_ROOT/scripts/lib.sh"
load_app_env
if [ "$APP_ENV" = "local" ]; then
  banner_local
  local_db_running || printf '! The local stack is not running. Start it with: mise run up\n'
  if command -v adb >/dev/null && adb get-state >/dev/null 2>&1; then
    for port in 54321 8081; do adb reverse "tcp:$port" "tcp:$port" >/dev/null; done
    printf 'adb reverse: phone → Mac ports 54321 (Supabase) and 8081 (Metro)\n'
  else
    printf '! No phone connected, skipping adb reverse. Re-run once it is plugged in.\n'
  fi
else
  banner_hosted
  if command -v adb >/dev/null && adb get-state >/dev/null 2>&1; then adb reverse tcp:8081 tcp:8081 >/dev/null; fi
fi
APP_VARIANT=development exec pnpm expo start --dev-client
