# Public by design: the local Supabase CLI stack's default URL and publishable key (docs/spec/dev-ex.md#secrets).
# Never put a secret in this file. Not named .env.local on purpose: see scripts/lib.sh load_app_env.
# The phone reaches 127.0.0.1 through `adb reverse` (mise run dev).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
EXPO_PUBLIC_APP_ENV=local
